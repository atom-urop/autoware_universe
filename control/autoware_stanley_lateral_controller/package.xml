<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autoware_stanley_lateral_controller</name>
  <version>0.50.0</version>
  <description>Stanley-based lateral controller for four-wheel steering vehicles</description>

  <maintainer email="atomailahim@gmail.com">ATOM</maintainer>

  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <buildtool_depend>autoware_cmake</buildtool_depend>

  <depend>autoware_control_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>autoware_trajectory_follower_base</depend>
  <depend>autoware_universe_utils</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
